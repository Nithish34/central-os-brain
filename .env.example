# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Caching & State Storage (Redis)
REDIS_URL=redis://localhost:6380/0

# Authentication & Security
JWT_SECRET=your-secret-key-here-min-32-chars
ENCRYPTION_KEY_CURRENT=v1:VGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWtleS0xMjM0NTY3OA==

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI & LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# Public Tunnel / HTTPS & Frontend URLs (For ngrok / production OAuth)
# Set PUBLIC_API_URL to your active ngrok URL (e.g. https://xxxx.ngrok-free.app)
PUBLIC_API_URL=
FRONTEND_URL=http://localhost:5173

# External Integrations (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# When tunneling through ngrok, set SLACK_REDIRECT_URI to your public HTTPS callback:
# SLACK_REDIRECT_URI=https://<your-subdomain>.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URI=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=
