# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Authentication & Security
JWT_SECRET=your-secret-key-here-min-32-chars
ENCRYPTION_KEY_CURRENT=v1:VGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWtleS0xMjM0NTY3OA==

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI & LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# External Integrations (Optional)
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=
