# ==============================================================================
# Company Brain OS - Production Environment Variables
# Copy this file to .env.production or set in your cloud provider environment
# ==============================================================================

# Server & Application
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=False
APP_NAME=Company Brain OS
API_V1_STR=/api/v1
CORS_ALLOWED_ORIGINS=*

# Layer 5: Gateway, JWT Security & Admin Bootstrap
# IMPORTANT: Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_strong_random_secret_in_production_2026
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
JWT_ISSUER=company-brain-gateway
JWT_AUDIENCE=company-brain-api
ADMIN_BOOTSTRAP_EMAIL=admin@companybrain.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_password

# Layer 1: Data Foundation (PostgreSQL + pgvector / Redis / Neo4j)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/company_brain
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=companybrain123

# Layer 2: Intelligence Core (Google Gemini Live LLM)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# Layer 4: Ingestion Webhook Secrets
SLACK_SIGNING_SECRET=your_slack_signing_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
TEAMS_CLIENT_SECRET=your_teams_client_secret
GMAIL_PUBSUB_VERIFICATION_TOKEN=your_gmail_token

# Layer 0: Execution Connectors (Live Integrations)
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=
JIRA_INSTANCE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
